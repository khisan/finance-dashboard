#!/usr/bin/env sh
# commit-msg: conservative auto-commit-message hook (loan-system semantics).
#
# Policy:
#   - never touch meaningful manual messages
#   - never touch Merge / Revert / fixup! / squash! / amend! commits
#   - regenerate only when the message is empty / comment-only, OR exactly
#     "AUTO" / "AUTO: ..." (anchor-checked, no false positives)
#   - fail-open: on any engine failure write the fallback and exit 0
#   - read staged diff from the REAL index via -z name-status (rename-safe,
#     handles spaces and unicode in file names)
#   - never reads secret files (.env, *.key, *.pem, *.p12, ...)
set -u

msg_file=${1:-}
[ -n "$msg_file" ] || exit 0

cd "$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

skip=0
# merge / revert / fixup! / squash! / amend!
if grep -Eq '^(Merge |Revert |fixup! |squash! |amend!)' "$msg_file" 2>/dev/null; then
  skip=1
fi
# meaningful manual message
if [ "$skip" -eq 0 ] && grep -Evq '^[[:space:]]*(#|$)' "$msg_file" 2>/dev/null; then
  skip=1
fi

is_auto=0
if printf '%s\n' "$msg_file" | grep -Eiq '^[[:space:]]*AUTO([:][[:space:]]*.*)?$'; then
  is_auto=1
fi

if [ "$skip" -eq 0 ] && { [ "$is_auto" -eq 1 ] || [ ! -s "$msg_file" ]; }; then
  engine="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/auto-commit.mjs"
  if [ ! -f "$engine" ]; then
    printf '%s\n' 'chore: update staged files' > "$msg_file"
    exit 0
  fi
  msg=$(node "$engine" --message-only </dev/null 2>/dev/null) || msg=""
  case "$msg" in ''|\#*) msg="chore: update staged files" ;; esac
  printf '%s\n' "$msg" > "$msg_file"
fi
exit 0
