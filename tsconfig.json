{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting / Strictness */
    "strict": false, // Set 'false' dulu saat transisi agar tidak terlalu banyak error bertumpuk
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,

    /* Path Aliases (jika kamu pakai import @/components) */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
